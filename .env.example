# Copy to .env and adjust. All values are optional; these are the defaults.

# LM Studio OpenAI-compatible server (LM Studio > Developer > Start Server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Any non-empty string unless you enabled authentication in LM Studio
LMSTUDIO_API_KEY=lm-studio

# Model keys as shown by `lms ls` or GET /api/v1/models.
# The text model drives the CrewAI agents; the vision model must support images.
LMSTUDIO_TEXT_MODEL=qwen/qwen3.5-9b
LMSTUDIO_VISION_MODEL=qwen/qwen3.5-9b

# Context window that models are loaded with
LMSTUDIO_CONTEXT_LENGTH=65536
# Max tokens generated per response
LMSTUDIO_MAX_TOKENS=8192
LMSTUDIO_TEMPERATURE=0.2
# Request timeout in seconds
LMSTUDIO_TIMEOUT=600
# Let the app load/reload models in LM Studio with LMSTUDIO_CONTEXT_LENGTH
LMSTUDIO_AUTO_LOAD=true
# Reasoning for thinking models (Qwen3.5 etc.): none/low/medium/high, or empty for the model default
LMSTUDIO_REASONING_EFFORT=none
